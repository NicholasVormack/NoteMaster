# NoteMaster API configuration
# Copy this file to server/.env and fill in real values.
# .env is gitignored; never commit real credentials.

# MongoDB connection string. Create a free cluster at https://cloud.mongodb.com,
# then Database Access -> add a user, and Network Access -> allow your IP.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Database name inside that cluster.
MONGODB_DB=you_note

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on.
PORT=8080
